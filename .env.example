# Postgres del servicio (Dokploy: el interno del contenedor, sin TLS)
DATABASE_URL=postgres://user:password@host:5432/naturgy
# "strict" | "require"/"true" | (vacío = sin SSL, tráfico interno Docker)
DATABASE_SSL=

# Contraseña de administrador único
ADMIN_PASSWORD=

# Secreto para firmar la cookie de sesión (cadena aleatoria larga, única por entorno)
SESSION_SECRET=

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000
